# Copy this file to .env and fill in real values. .env is gitignored — never commit it.

# Anthropic API key, used server-side only (app/server.js) to power "Ask Ledger".
ANTHROPIC_API_KEY=sk-ant-XXXXXXXXXXXXXXXXXXXXXXXX

# Login credentials for the web page. Choose your own username and password.
APP_USERNAME=demo-user
APP_PASSWORD=demo-pass

# Supabase Postgres connection string (Project Settings -> Connect -> URI, or the Session
# pooler URI if your network doesn't support the direct connection's IPv6 host).
DATABASE_URL=
